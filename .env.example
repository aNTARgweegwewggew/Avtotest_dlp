# Скопируйте этот файл в .env и заполните только настройки нужных тестов.
# Не указывайте реальные пароли, OAuth-токены или адреса в Git.

# Тестовая почта
MAIL_HOST=mail.example.test
MAIL_USERNAME=replace-with-test-mail-user
MAIL_PASSWORD=replace-with-test-mail-password
MAIL_FROM=autotest-sender@example.test
MAIL_TO=autotest-recipient@example.test
SMTP_TEST_PORTS=25,587
POP3_TEST_PORTS=110,995
IMAP_TEST_PORTS=143,993
MAIL_TIMEOUT_SECONDS=20
MAIL_DELIVERY_TIMEOUT_SECONDS=60

# DLP PostgreSQL — нужно только для проверки инцидентов в базе.
DB_HOST=db.example.test
DB_NAME=dlp
DB_USER=replace-with-read-only-test-user
DB_PASSWORD=replace-with-database-password
DB_CONNECT_TIMEOUT=10
DLP_INCIDENT_TIMEOUT_SECONDS=90

# Яндекс.Диск
YANDEX_TOKEN_FILE=secrets/yandex_token.json
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_DISK_TEST_FOLDER=/DLP_AUTOTEST

# Яндекс.Почта — отдельный OAuth-токен и отдельный почтовый ящик.
# В JSON-файле токена должен быть ключ access_token.
YANDEX_MAIL_TOKEN_FILE=secrets/yandex_mail_token.json
YANDEX_MAIL_HOST=smtp.yandex.com
YANDEX_MAIL_PORT=465
YANDEX_MAIL_USERNAME=replace-with-yandex-mail-login
YANDEX_MAIL_FROM=autotest-sender@example.test
YANDEX_MAIL_TO=autotest-recipient@example.test

# Google Drive
GOOGLE_DRIVE_TOKEN_FILE=secrets/google_drive_token.json
GOOGLE_DRIVE_TEST_FOLDER_ID=

# Дополнительный сетевой тест Google Search отключён по умолчанию.
RUN_GOOGLE_SEARCH_TESTS=0

# Telegram — отправка сообщений от пользовательского аккаунта, не от бота.
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_TEST_USERNAME=
# Скрипт авторизации создаёт файл сессии: secrets/telegram_user.session

# HTTPS. При TLS-инспекции укажите путь к доверенному CA-сертификату.
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=
TLS_VERIFY=true
